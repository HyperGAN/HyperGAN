concat(rgb, gray)
conv(${w1}, kernel_size=4, stride=2, padding=1)
leaky_relu(0.2)
conv(${w2}, kernel_size=4, stride=2, padding=1)
leaky_relu(0.2)
conv(${w4}, kernel_size=4, stride=2, padding=1)
leaky_relu(0.2)
conv(${w4}, kernel_size=4, stride=2, padding=1)
leaky_relu(0.2)
attention_input = identity()
${attention}
conv(${w4}, kernel_size=4, stride=2, padding=1)
leaky_relu(0.2)
conv(${w4}, kernel_size=4, stride=2, padding=1)
leaky_relu(0.2)
flatten()
linear(1, name="output")
