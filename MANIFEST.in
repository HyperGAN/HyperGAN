prune hypergan
prune docs
prune examples
include examples/paired-linear.toml
include examples/execution/*.toml
prune worktrees
prune tests
recursive-include tests/foundation *.py
recursive-include tests/reference *.py
recursive-include tests/cuda *.py
recursive-include tests/reducers *.py
recursive-include tests/browser *.py
recursive-include reducers/core *.toml *.lock *.rs *.md *.py
include reducers/core/rust-toolchain.toml
prune reducers/core/target
include scripts/build_reducer.py
include scripts/reducer_proof.py
include scripts/metrics_server_proof.py
include scripts/metrics_training_proof.py
recursive-include src/hypergan/metrics_reducer/assets *.txt
recursive-include src/hypergan/metrics_reducer/assets *.wasm *.json *.js *.html
recursive-include src/hypergan/web_assets *.html *.css *.js *.txt *.json
recursive-include tests/web *.py
recursive-include frontend *.json *.js *.mjs *.md
prune frontend/node_modules
