conv(${w1}, kernel_size=4, stride=2, padding=1)
group_norm(${g1})
leaky_relu(0.2)
conv(${w2}, kernel_size=4, stride=2, padding=1)
group_norm(${g2})
leaky_relu(0.2)
conv(${w4}, kernel_size=4, stride=2, padding=1)
group_norm(${g4})
leaky_relu(0.2)
conv(${w8}, kernel_size=4, stride=2, padding=1)
group_norm(${g8})
leaky_relu(0.2)
conv(${w8}, kernel_size=4, stride=2, padding=1)
group_norm(${g8})
leaky_relu(0.2)
conv(${w8}, kernel_size=4, stride=2, padding=1)
group_norm(${g8})
leaky_relu(0.2)
flatten()
