# Convert RGB [-1,1] to ImageNet-normalized input, with explicit channel constants.
h = scale(x, 0.5)
half = constant(h, 3, 1, 1, value=0.5)
h = broadcast_add(h, half)
r, gb = split(h, 1, dim=1)
g, b = split(gb, 1, dim=1)
rm = constant(r, 1, 1, 1, value=-0.485)
gm = constant(g, 1, 1, 1, value=-0.456)
bm = constant(b, 1, 1, 1, value=-0.406)
r = broadcast_add(r, rm)
g = broadcast_add(g, gm)
b = broadcast_add(b, bm)
r = scale(r, 4.3668122270742356)
g = scale(g, 4.464285714285714)
b = scale(b, 4.444444444444445)
normalized = concat(r, g, b)
features = pretrained(normalized, ${weights_path}, provider="dinov3_vits16", sha256=${weights_sha256}, readout="multidepth", name="backbone", trainable=False)
m0, rest = split(features, 384, dim=1)
m1, rest = split(rest, 384, dim=1)
m2, m3 = split(rest, 384, dim=1)
