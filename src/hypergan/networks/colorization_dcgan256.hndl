conv(${w1}, kernel_size=4, stride=2, padding=1, spectral_norm=${spectral_norm})
leaky_relu(0.2)
conv(${w2}, kernel_size=4, stride=2, padding=1, spectral_norm=${spectral_norm})
leaky_relu(0.2)
conv(${w4}, kernel_size=4, stride=2, padding=1, spectral_norm=${spectral_norm})
leaky_relu(0.2)
conv(${w8}, kernel_size=4, stride=2, padding=1, spectral_norm=${spectral_norm})
leaky_relu(0.2)
conv(${w8}, kernel_size=4, stride=2, padding=1, spectral_norm=${spectral_norm})
leaky_relu(0.2)
conv(${w8}, kernel_size=4, stride=2, padding=1, spectral_norm=${spectral_norm})
leaky_relu(0.2)
flatten()
linear(1, spectral_norm=${spectral_norm})
