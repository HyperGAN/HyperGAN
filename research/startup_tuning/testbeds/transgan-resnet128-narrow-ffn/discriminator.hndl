# 128px pixel + multiscale pretrained discriminator. Input RGB in [-1, 1].
# All trainable topology and branch connections are declared here.
# HNDL >=0.4.0: one shared frozen backbone processes candidate and zero-image
# context together. Both pixel and feature paths retain the CIFAR fixed context.
# Pixel widths scale to 128px with five downsampling blocks and attention at 16px.
context = constant(x, 3, 128, 128)
zero_embedding = constant(x, 128)
pixels = concat(x, context)
h = conv(pixels, 32, kernel_size=3, padding=1, name="pixel_input")

# Pixel residual block 1: 32 -> 64 channels, 128 -> 64px.
branch = group_norm(h, 8, name="pixel_block0_norm1")
branch = leaky_relu(branch, 0.2)
branch = conv(branch, 64, kernel_size=3, padding=1, name="pixel_block0_conv1")
condition = leaky_relu(zero_embedding, 0.2)
condition = linear(condition, 64, name="pixel_block0_condition")
branch = group_norm(branch, 8, name="pixel_block0_norm2")
condition = reshape(condition, 64, 1, 1)
branch = broadcast_add(branch, condition)
branch = leaky_relu(branch, 0.2)
branch = conv(branch, 64, kernel_size=3, padding=1, name="pixel_block0_conv2")
shortcut = conv(h, 64, kernel_size=1, name="pixel_block0_shortcut")
h = add(shortcut, branch)
h = scale(h, 0.7071067811865475)
h = avg_pool(h, 2)

# Pixel residual block 2: 64 -> 128 channels, 64 -> 32px.
branch = group_norm(h, 8, name="pixel_block1_norm1")
branch = leaky_relu(branch, 0.2)
branch = conv(branch, 128, kernel_size=3, padding=1, name="pixel_block1_conv1")
condition = leaky_relu(zero_embedding, 0.2)
condition = linear(condition, 128, name="pixel_block1_condition")
branch = group_norm(branch, 8, name="pixel_block1_norm2")
condition = reshape(condition, 128, 1, 1)
branch = broadcast_add(branch, condition)
branch = leaky_relu(branch, 0.2)
branch = conv(branch, 128, kernel_size=3, padding=1, name="pixel_block1_conv2")
shortcut = conv(h, 128, kernel_size=1, name="pixel_block1_shortcut")
h = add(shortcut, branch)
h = scale(h, 0.7071067811865475)
h = avg_pool(h, 2)

# Pixel residual block 3: 128 -> 128 channels, 32 -> 16px.
branch = group_norm(h, 8, name="pixel_block2_norm1")
branch = leaky_relu(branch, 0.2)
branch = conv(branch, 128, kernel_size=3, padding=1, name="pixel_block2_conv1")
condition = leaky_relu(zero_embedding, 0.2)
condition = linear(condition, 128, name="pixel_block2_condition")
branch = group_norm(branch, 8, name="pixel_block2_norm2")
condition = reshape(condition, 128, 1, 1)
branch = broadcast_add(branch, condition)
branch = leaky_relu(branch, 0.2)
branch = conv(branch, 128, kernel_size=3, padding=1, name="pixel_block2_conv2")
shortcut = h
h = add(shortcut, branch)
h = scale(h, 0.7071067811865475)
h = avg_pool(h, 2)

# Unscaled SAGAN attention at 16px, with a fixed unit residual.
query = conv(h, 16, kernel_size=1, bias=False, name="attention_query")
query = reshape(query, 16, 256)
query = transpose(query, 1, 2)
key = conv(h, 16, kernel_size=1, bias=False, name="attention_key")
key = reshape(key, 16, 256)
probabilities = matmul(query, key)
probabilities = softmax(probabilities, dim=2)
value = conv(h, 64, kernel_size=1, bias=False, name="attention_value")
value = reshape(value, 64, 256)
probabilities = transpose(probabilities, 1, 2)
attended = matmul(value, probabilities)
attended = reshape(attended, 64, 16, 16)
attended = conv(attended, 128, kernel_size=1, bias=False, name="attention_project")
h = add(h, attended)

# Pixel residual block 4: 128 -> 128 channels, 16 -> 8px.
branch = group_norm(h, 8, name="pixel_block3_norm1")
branch = leaky_relu(branch, 0.2)
branch = conv(branch, 128, kernel_size=3, padding=1, name="pixel_block3_conv1")
condition = leaky_relu(zero_embedding, 0.2)
condition = linear(condition, 128, name="pixel_block3_condition")
branch = group_norm(branch, 8, name="pixel_block3_norm2")
condition = reshape(condition, 128, 1, 1)
branch = broadcast_add(branch, condition)
branch = leaky_relu(branch, 0.2)
branch = conv(branch, 128, kernel_size=3, padding=1, name="pixel_block3_conv2")
shortcut = h
h = add(shortcut, branch)
h = scale(h, 0.7071067811865475)
h = avg_pool(h, 2)

# Pixel residual block 5: 128 -> 128 channels, 8 -> 4px.
branch = group_norm(h, 8, name="pixel_block4_norm1")
branch = leaky_relu(branch, 0.2)
branch = conv(branch, 128, kernel_size=3, padding=1, name="pixel_block4_conv1")
condition = leaky_relu(zero_embedding, 0.2)
condition = linear(condition, 128, name="pixel_block4_condition")
branch = group_norm(branch, 8, name="pixel_block4_norm2")
condition = reshape(condition, 128, 1, 1)
branch = broadcast_add(branch, condition)
branch = leaky_relu(branch, 0.2)
branch = conv(branch, 128, kernel_size=3, padding=1, name="pixel_block4_conv2")
shortcut = h
h = add(shortcut, branch)
h = scale(h, 0.7071067811865475)
h = avg_pool(h, 2)

h = leaky_relu(h, 0.2)
h = flatten(h)
pixel_score = linear(h, 1, name="pixel_score")

# Join along batch before normalization: raw zero context is midgray RGB.
# ResNet preprocessing: (RGB * 0.5 + 0.5 - ImageNet mean) / std.
feature_batch = concat(x, context, axis=0, name="feature_batch")
scaled = scale(feature_batch, 0.5)
half = constant(feature_batch, 3, 1, 1, value=0.5)
normalized = broadcast_add(scaled, half)
red, green_blue = split(normalized, 1)
green, blue = split(green_blue, 1)
red_bias = constant(red, 1, 1, 1, value=-0.485)
red = broadcast_add(red, red_bias)
red = scale(red, 4.3668122270742355)
green_bias = constant(green, 1, 1, 1, value=-0.456)
green = broadcast_add(green, green_bias)
green = scale(green, 4.464285714285714)
blue_bias = constant(blue, 1, 1, 1, value=-0.406)
blue = broadcast_add(blue, blue_bias)
blue = scale(blue, 4.444444444444445)
normalized = concat(red, green, blue, name="normalized")

# One frozen backbone, one pass at batch 2*B, native 32px / 16px / 8px maps.
# Frozen BatchNorm uses checkpoint statistics; examples remain independent.
feature1, feature2, feature3 = pretrained(normalized, ${weights_path},
    provider="torchvision_resnet18", sha256=${weights_sha256},
    layers=("layer1", "layer2", "layer3"), trainable=False, name="resnet")

# Candidate + fixed-context feature head 1, native 32px map.
candidate1, context1 = chunk(feature1, 2, dim=0, name="feature1_split")
head1 = concat(candidate1, context1, name="feature1_join")
head1 = conv(head1, 64, kernel_size=1, name="feature1_project")
head1 = group_norm(head1, 8, name="feature1_norm")
head1 = leaky_relu(head1, 0.2)
head1 = conv(head1, 64, kernel_size=3, padding=1, name="feature1_conv")
head1 = leaky_relu(head1, 0.2)
head1 = adaptive_avg_pool(head1, 4)
head1 = flatten(head1)
score1 = linear(head1, 1, name="feature1_score")

# Candidate + fixed-context feature head 2, native 16px map.
candidate2, context2 = chunk(feature2, 2, dim=0, name="feature2_split")
head2 = concat(candidate2, context2, name="feature2_join")
head2 = conv(head2, 64, kernel_size=1, name="feature2_project")
head2 = group_norm(head2, 8, name="feature2_norm")
head2 = leaky_relu(head2, 0.2)
head2 = conv(head2, 64, kernel_size=3, padding=1, name="feature2_conv")
head2 = leaky_relu(head2, 0.2)
head2 = adaptive_avg_pool(head2, 4)
head2 = flatten(head2)
score2 = linear(head2, 1, name="feature2_score")

# Candidate + fixed-context feature head 3, native 8px map.
candidate3, context3 = chunk(feature3, 2, dim=0, name="feature3_split")
head3 = concat(candidate3, context3, name="feature3_join")
head3 = conv(head3, 64, kernel_size=1, name="feature3_project")
head3 = group_norm(head3, 8, name="feature3_norm")
head3 = leaky_relu(head3, 0.2)
head3 = conv(head3, 64, kernel_size=3, padding=1, name="feature3_conv")
head3 = leaky_relu(head3, 0.2)
head3 = adaptive_avg_pool(head3, 4)
head3 = flatten(head3)
score3 = linear(head3, 1, name="feature3_score")

# CIFAR branch weighting: (pixel + (head1 + head2 + head3) / sqrt(3)) / sqrt(2).
feature_score = concat(score1, score2, score3)
feature_score = sum(feature_score, 1, keepdim=True)
feature_score = scale(feature_score, 0.5773502691896258)
score = add(pixel_score, feature_score)
out = scale(score, 0.7071067811865475)
