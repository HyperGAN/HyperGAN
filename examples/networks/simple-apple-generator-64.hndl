# Simple 64x64 RGB generator using bilinear upsampling + 3x3 convolutions
# to avoid deconvolution checkerboard artifacts under ViT patch gradients.
reshape(128, 1, 1)
deconv(256, kernel_size=4, stride=1, padding=0, bias=False)
batch_norm()
silu()
upsample(scale_factor=2, mode="bilinear")
conv(128, kernel_size=3, stride=1, padding=1, bias=False)
batch_norm()
silu()
upsample(scale_factor=2, mode="bilinear")
conv(64, kernel_size=3, stride=1, padding=1, bias=False)
batch_norm()
silu()
upsample(scale_factor=2, mode="bilinear")
conv(32, kernel_size=3, stride=1, padding=1, bias=False)
batch_norm()
silu()
upsample(scale_factor=2, mode="bilinear")
conv(16, kernel_size=3, stride=1, padding=1, bias=False)
batch_norm()
silu()
conv(3, kernel_size=3, stride=1, padding=1)
tanh()
