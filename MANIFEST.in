prune hypergan
include setup.py
include src/hypergan/_build_provenance.json
prune docs
prune reports
prune .agents
prune .claude
prune examples
recursive-include examples *.toml *.hndl *.py *.md *.json
prune worktrees
prune tests
include tests/hndl_fixtures.py
include tests/dinov3_fixtures.py
recursive-include tests/fixtures *.toml
recursive-include tests/foundation *.py
recursive-include tests/reference *.py
recursive-include tests/cuda *.py
recursive-include tests/reducers *.py
recursive-include tests/browser *.py
recursive-include tests/web *.py
recursive-include tests/unit *.py
recursive-include tests/playbooks *.py
recursive-include tests/e2e_integration *.py
recursive-include scripts *.py *.sh
recursive-include src/hypergan/web_assets *.html *.css *.js *.txt *.json *.png
recursive-include src/hypergan/networks *.hndl
recursive-include src/hypergan/models *.toml
recursive-include frontend *.json *.js *.mjs *.md
prune frontend/node_modules
