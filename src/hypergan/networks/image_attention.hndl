# Unscaled SAGAN attention, with an active unit residual and explicit projections.
${prefix}_query = conv(${input}, ${query_channels}, kernel_size=1, bias=False, name="${prefix}_query")
${prefix}_query = reshape(${prefix}_query, ${query_channels}, ${positions})
${prefix}_query = transpose(${prefix}_query, 1, 2)
${prefix}_key = conv(${input}, ${query_channels}, kernel_size=1, bias=False, name="${prefix}_key")
${prefix}_key = reshape(${prefix}_key, ${query_channels}, ${positions})
${prefix}_scores = matmul(${prefix}_query, ${prefix}_key)
${prefix}_probabilities = softmax(${prefix}_scores, dim=2)
${prefix}_value = conv(${input}, ${value_channels}, kernel_size=1, bias=False, name="${prefix}_value")
${prefix}_value = reshape(${prefix}_value, ${value_channels}, ${positions})
${prefix}_probabilities = transpose(${prefix}_probabilities, 1, 2)
${prefix}_attended = matmul(${prefix}_value, ${prefix}_probabilities)
${prefix}_attended = reshape(${prefix}_attended, ${value_channels}, ${size}, ${size})
${prefix}_project = conv(${prefix}_attended, ${channels}, kernel_size=1, bias=False, name="${prefix}_project")
${prefix}_out = add(${input}, ${prefix}_project)
