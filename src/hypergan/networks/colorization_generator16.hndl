# Latent-only 256px decoder. Each residual block uses nearest upsampling.
linear(${w8x16}, name="input")
reshape(${w8}, 4, 4)
group_norm(${g8})
leaky_relu(0.2)
u8 = upsample(2, mode="nearest")
h8 = conv(u8, ${w8}, kernel_size=3, padding=1)
group_norm(${g8})
leaky_relu(0.2)
conv(${w8}, kernel_size=3, padding=1)
group_norm(${g8})
h8 = leaky_relu(0.2)
s8 = conv(u8, ${w8}, kernel_size=1)
add(h8, s8)
scale(0.7071067811865476)
u16 = upsample(2, mode="nearest")
h16 = conv(u16, ${w4}, kernel_size=3, padding=1)
group_norm(${g4})
leaky_relu(0.2)
conv(${w4}, kernel_size=3, padding=1)
group_norm(${g4})
h16 = leaky_relu(0.2)
s16 = conv(u16, ${w4}, kernel_size=1)
add(h16, s16)
scale(0.7071067811865476)
attention_input = identity()
${attention}
u32 = upsample(2, mode="nearest")
h32 = conv(u32, ${w2}, kernel_size=3, padding=1)
group_norm(${g2})
leaky_relu(0.2)
conv(${w2}, kernel_size=3, padding=1)
group_norm(${g2})
h32 = leaky_relu(0.2)
s32 = conv(u32, ${w2}, kernel_size=1)
add(h32, s32)
scale(0.7071067811865476)
u64 = upsample(2, mode="nearest")
h64 = conv(u64, ${w1}, kernel_size=3, padding=1)
group_norm(${g1})
leaky_relu(0.2)
conv(${w1}, kernel_size=3, padding=1)
group_norm(${g1})
h64 = leaky_relu(0.2)
s64 = conv(u64, ${w1}, kernel_size=1)
add(h64, s64)
scale(0.7071067811865476)
u128 = upsample(2, mode="nearest")
h128 = conv(u128, ${w1}, kernel_size=3, padding=1)
group_norm(${g1})
leaky_relu(0.2)
conv(${w1}, kernel_size=3, padding=1)
group_norm(${g1})
h128 = leaky_relu(0.2)
s128 = conv(u128, ${w1}, kernel_size=1)
add(h128, s128)
scale(0.7071067811865476)
u256 = upsample(2, mode="nearest")
h256 = conv(u256, ${w1}, kernel_size=3, padding=1)
group_norm(${g1})
leaky_relu(0.2)
conv(${w1}, kernel_size=3, padding=1)
group_norm(${g1})
h256 = leaky_relu(0.2)
s256 = conv(u256, ${w1}, kernel_size=1)
add(h256, s256)
scale(0.7071067811865476)
conv(3, kernel_size=3, padding=1, name="output")
tanh()
