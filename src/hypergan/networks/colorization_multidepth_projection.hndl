# Native named inputs m0..m3; outputs o0..o3 form the feature pyramid.
c0 = conv(m0, ${width}, kernel_size=1, trainable=False, name="channel0")
c0 = upsample(c0, 2, mode="nearest")
c1 = conv(m1, ${width}, kernel_size=1, trainable=False, name="channel1")
c2 = conv(m2, ${width}, kernel_size=1, trainable=False, name="channel2")
c2 = avg_pool(c2, 2, stride=2)
c3 = conv(m3, ${width}, kernel_size=1, trainable=False, name="channel3")
c3 = avg_pool(c3, 4, stride=4)
o3 = conv(c3, ${width}, kernel_size=1, trainable=False, name="fusion3")
u2 = upsample(o3, 2, mode="nearest")
c2 = add(c2, u2)
o2 = conv(c2, ${width}, kernel_size=1, trainable=False, name="fusion2")
u1 = upsample(o2, 2, mode="nearest")
c1 = add(c1, u1)
o1 = conv(c1, ${width}, kernel_size=1, trainable=False, name="fusion1")
u0 = upsample(o1, 2, mode="nearest")
c0 = add(c0, u0)
o0 = conv(c0, ${width}, kernel_size=1, trainable=False, name="fusion0")
