# 128px DINOv3 Projected GAN critic with patch-RGB color conditioning and multiscale spatial head.
# Input RGB in [-1, 1]. Frozen ViT-S/16 multidepth backbone (blocks 2, 5, 8, 11 at native 8x8 grid)
# with GroupNorm + position-sensitive linear readouts, plus a lightweight multiscale spatial/color branch.
scaled = scale(x, 0.5)
half = constant(x, 3, 1, 1, value=0.5)
normalized = broadcast_add(scaled, half)
red, green_blue = split(normalized, 1)
green, blue = split(green_blue, 1)
red_bias = constant(red, 1, 1, 1, value=-0.485)
red = broadcast_add(red, red_bias)
red = scale(red, 4.3668122270742355)
green_bias = constant(green, 1, 1, 1, value=-0.456)
green = broadcast_add(green, green_bias)
green = scale(green, 4.464285714285714)
blue_bias = constant(blue, 1, 1, 1, value=-0.406)
blue = broadcast_add(blue, blue_bias)
blue = scale(blue, 4.444444444444445)
normalized = concat(red, green, blue, name="normalized")

# Frozen ViT-S/16. The multidepth readout returns LayerNorm-normalized blocks
# 2, 5, 8, and 11 concatenated on channels: [B, 1536, 8, 8].
features = pretrained(normalized, ${weights_path},
    provider="dinov3_vits16", sha256=${weights_sha256},
    readout="multidepth", trainable=False, name="backbone")
feature1, remaining = split(features, 384, name="depth1_split")
feature2, remaining = split(remaining, 384, name="depth2_split")
feature3, feature4 = split(remaining, 384, name="depth3_split")

# Patch mean RGB at 8x8 so DINOv3 heads directly observe local color and background brightness.
patch_rgb = avg_pool(normalized, 16)

# Projected head 1 (block 2 + patch RGB, 8x8 -> 4x4 -> scalar)
h1 = concat(feature1, patch_rgb, name="disc1_join")
h1 = conv(h1, 64, kernel_size=1, name="disc1_ccm")
h1 = group_norm(h1, 8, name="disc1_norm")
h1 = leaky_relu(h1, 0.2)
h1 = conv(h1, 64, kernel_size=3, padding=1, stride=2, name="disc1_down")
h1 = leaky_relu(h1, 0.2)
h1 = flatten(h1)
score1 = linear(h1, 1, bias=False, name="disc1_logit")

# Projected head 2 (block 5 + patch RGB, 8x8 -> 4x4 -> scalar)
h2 = concat(feature2, patch_rgb, name="disc2_join")
h2 = conv(h2, 64, kernel_size=1, name="disc2_ccm")
h2 = group_norm(h2, 8, name="disc2_norm")
h2 = leaky_relu(h2, 0.2)
h2 = conv(h2, 64, kernel_size=3, padding=1, stride=2, name="disc2_down")
h2 = leaky_relu(h2, 0.2)
h2 = flatten(h2)
score2 = linear(h2, 1, bias=False, name="disc2_logit")

# Projected head 3 (block 8 + patch RGB, 8x8 -> 4x4 -> scalar)
h3 = concat(feature3, patch_rgb, name="disc3_join")
h3 = conv(h3, 64, kernel_size=1, name="disc3_ccm")
h3 = group_norm(h3, 8, name="disc3_norm")
h3 = leaky_relu(h3, 0.2)
h3 = conv(h3, 64, kernel_size=3, padding=1, stride=2, name="disc3_down")
h3 = leaky_relu(h3, 0.2)
h3 = flatten(h3)
score3 = linear(h3, 1, bias=False, name="disc3_logit")

# Projected head 4 (block 11 + patch RGB, 8x8 -> 4x4 -> scalar)
h4 = concat(feature4, patch_rgb, name="disc4_join")
h4 = conv(h4, 64, kernel_size=1, name="disc4_ccm")
h4 = group_norm(h4, 8, name="disc4_norm")
h4 = leaky_relu(h4, 0.2)
h4 = conv(h4, 64, kernel_size=3, padding=1, stride=2, name="disc4_down")
h4 = leaky_relu(h4, 0.2)
h4 = flatten(h4)
score4 = linear(h4, 1, bias=False, name="disc4_logit")

# Multiscale spatial/color pyramid (128 -> 64 -> 32 -> 16 -> 8 -> 4)
# covering sub-patch (16x16) frequencies and global RGB distribution.
context = constant(x, 3, 128, 128)
pixels = concat(x, context, name="sp_pixels")
sp = avg_pool(pixels, 2)
sp = conv(sp, 32, kernel_size=3, padding=1, stride=2, name="sp_conv32")
sp = group_norm(sp, 8, name="sp_norm32")
sp = leaky_relu(sp, 0.2)
sp = conv(sp, 64, kernel_size=3, padding=1, stride=2, name="sp_conv16")
sp = group_norm(sp, 8, name="sp_norm16")
sp = leaky_relu(sp, 0.2)
sp = conv(sp, 64, kernel_size=3, padding=1, stride=2, name="sp_conv8")
sp = group_norm(sp, 8, name="sp_norm8")
sp = leaky_relu(sp, 0.2)
sp = conv(sp, 64, kernel_size=3, padding=1, stride=2, name="sp_conv4")
sp = leaky_relu(sp, 0.2)
sp = flatten(sp)
score_sp = linear(sp, 1, bias=False, name="sp_logit")

# Equal-variance combination across the five heads: sum / sqrt(5).
feature_score = concat(score1, score2, score3, score4, score_sp)
feature_score = sum(feature_score, 1, keepdim=True)
out = scale(feature_score, 0.4472135954999579)
