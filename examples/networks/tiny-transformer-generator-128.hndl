# Direct z -> 64 spatial tokens; two pre-LayerNorm transformer blocks.
# Each position has its own projection weights, so no position table is needed.
h = linear(x, 16384, name="input_projection")
h = reshape(h, 64, 256)

branch = layer_norm(h, name="block0_attention_norm")
branch = attention(branch, 4, dropout=0.0, qkv_bias=True, out_bias=True, name="block0_attention")
h = add(h, branch)
branch = layer_norm(h, name="block0_ffn_norm")
branch = feed_forward(branch, 512, activation="gelu", dropout=0.0, name="block0_ffn")
h = add(h, branch)

branch = layer_norm(h, name="block1_attention_norm")
branch = attention(branch, 4, dropout=0.0, qkv_bias=True, out_bias=True, name="block1_attention")
h = add(h, branch)
branch = layer_norm(h, name="block1_ffn_norm")
branch = feed_forward(branch, 512, activation="gelu", dropout=0.0, name="block1_ffn")
h = add(h, branch)

# Normalized nearest-neighbor upsampling and 3x3 convolutions: 8 -> 16 -> 32 -> 64 -> 128.
# GroupNorm keeps activation variance O(1) across all 4 upsampling stages; affine=False on
# norm128 prevents unscaled 1D bias steps from DC-saturating tanh under DualNorm.
h = layer_norm(h, name="post_transformer_norm")
h = permute(h, 2, 1)
h = reshape(h, 256, 8, 8)
h = upsample(h, 2, mode="nearest")
h = conv(h, 128, kernel_size=3, padding=1, bias=False, name="conv16")
h = group_norm(h, 8, name="norm16")
h = leaky_relu(h, 0.2)
h = upsample(h, 2, mode="nearest")
h = conv(h, 64, kernel_size=3, padding=1, bias=False, name="conv32")
h = group_norm(h, 8, name="norm32")
h = leaky_relu(h, 0.2)
h = upsample(h, 2, mode="nearest")
h = conv(h, 32, kernel_size=3, padding=1, bias=False, name="conv64")
h = group_norm(h, 8, name="norm64")
h = leaky_relu(h, 0.2)
h = upsample(h, 2, mode="nearest")
h = conv(h, 16, kernel_size=3, padding=1, bias=False, name="conv128")
h = group_norm(h, 8, affine=False, name="norm128")
h = leaky_relu(h, 0.2)
h = conv(h, 3, kernel_size=3, padding=1, bias=False, name="rgb")
out = tanh(h)
