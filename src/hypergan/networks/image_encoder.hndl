conv(${width}, kernel_size=4, stride=2, padding=1, name="conv1")
group_norm(8)
leaky_relu(0.2)
conv(${width2}, kernel_size=4, stride=2, padding=1, name="conv2")
group_norm(8)
leaky_relu(0.2)
conv(${width4}, kernel_size=4, stride=2, padding=1, name="conv3")
group_norm(8)
leaky_relu(0.2)
h = flatten()
q = linear(h, ${z_dim}, name="query")
q = layer_norm(q, affine=False)
o = linear(h, ${z_dim}, name="offset", init={"weight": 0, "bias": 0})
o = scale(o, 0.3333333333333333)
o = tanh(o)
o = scale(o, 3.0)
concat(q, o, axis=1)
